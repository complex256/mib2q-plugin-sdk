#!/usr/bin/env bash
# mibsdk-dev: drive the mibsdk plugin SDK on an Audi MHI2Q head unit over SSH (runs on the Mac).
#
# A thin transport over the unit's mibpkg (/tmp/mibpkg, 0.9.1 or later): every change on the unit is a mibpkg verb,
# and mibpkg owns every /mnt/app write. This tool only uploads files to /tmp (`ssh ... "cat > /tmp/<name>"`, read
# back and compared: there is no scp) and passes mibpkg's output and exit code through (3: permissions to approve,
# 2: bad usage, 1: failed or busy). Only log, restart and ui-forcefail talk to the unit directly (ui-forcefail
# writes a developer switch under /mnt/persist, which is read-write: no remount).
# This tool never reads or prints the j9 command line (lsd.sh embeds the VIN and IMSI).
set -euo pipefail

MIBPKG="/tmp/mibpkg"
LOG="/tmp/mibsdk.log"
FORCEFAIL_DIR="/mnt/persist/mibsdk/dev"
FORCEFAIL="$FORCEFAIL_DIR/ui.forcefail"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST="${MIBSDK_DIST:-$HERE/../dist/build/dist}"
SSH_OPTS=(-o HostKeyAlgorithms=ssh-rsa -o PubkeyAcceptedKeyTypes=ssh-rsa -o BatchMode=yes
          -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=3)

HOST="${MIBSDK_HOST:-}"
TMP=""
SNAP=""
UPLOADED_ALSO=""

usage() {
  cat <<USAGE
usage: mibsdk-dev <command> [args] [host]      (host: the last argument, else \$MIBSDK_HOST)

Every command but log, restart and ui-forcefail runs a verb of the unit's mibpkg (0.9.1 or later; see the mibpkg README) and
exits with its status: 3 asks for permissions to be approved (the lines say which, ending in "approve with:").

  install                    install or update the SDK: uploads the single $DIST/mibsdk-*.mpk (or \$MIBSDK_MPK;
                             build it with ./gradlew :dist:mibpkgPackage), then: mibpkg install-file mibsdk
  uninstall [--purge] [--force]
                             mibpkg remove mibsdk; --purge also deletes plugin data, --force uninstalls while
                             overrides of vehicle state are still in force
  install-plugin <file.mpk> [--approve=<perm,...>]
                             install or update a plugin package (upload, then mibpkg install-file <id>)
  remove <id> [--purge|--purge-data]
                             mibpkg sdk remove <id>: a plugin package or a pushed plugin; keeps its data unless --purge
  push <plugin.jar>          upload the jar and its <jar>.stamp (build with ./gradlew :<project>:mibPluginJar), then
                             mibpkg sdk push <id>: installs it as plugins/<id>.jar and requests a reload
  grant <id> <perm,...>      mibpkg sdk grant (an empty list revokes all; a plugin missing a grant does not run)
  safe-mode on|off           mibpkg sdk safe-mode (off also resets boot.state)
  boot-state set-wrap <n>    mibpkg sdk boot-state set-wrap <n>
  data-clear <id>            mibpkg sdk data-clear <id> (restart afterwards to free the storage cap)
  status                     mibpkg sdk status: the HMICar= and HMISystem= lines, the SDK, its plugins, the ledger,
                             the STATUS lines
  log                        print $LOG
  restart                    restart the HMI (on a bench unit this resets the whole unit, 2-3 min)
  ui-forcefail factory|screen|off
                             developer switch: write (or, with off, remove) $FORCEFAIL so the SDK's
                             main-menu takeover fails on purpose (factory: the SDK factory throws; screen: adding the
                             Plugins row to the MENU ring throws);
                             read at boot, so restart afterwards

Environment: MIBSDK_HOST names the unit when it is not the last argument; MIBSDK_DIST overrides the dist directory
(default dist/build/dist); MIBSDK_MPK names the SDK .mpk.
USAGE
}

die() { echo "mibsdk-dev: $*" >&2; exit 1; }
# usage_err: a bad command line, caught on this machine; exits 2 like mibpkg's own usage errors.
usage_err() { echo "mibsdk-dev: $*" >&2; exit 2; }
info() { echo "mibsdk-dev: $*" >&2; }

cleanup() {
  local rc=$?
  if [ -n "$TMP" ]; then rm -rf "$TMP"; fi
  return $rc
}
trap cleanup EXIT

rsh() { ssh "${SSH_OPTS[@]}" "root@$HOST" "$@"; }

set_host() {
  HOST="$1"
  case "$HOST" in
    ""|-*|*[!A-Za-z0-9._:-]*) usage_err "invalid host '$HOST'" ;;
  esac
}

make_tmp() { [ -n "$TMP" ] || TMP="$(mktemp -d "${TMPDIR:-/tmp}/mibsdk-dev.XXXXXX")"; }

connect() {
  rsh "echo ok" >/dev/null 2>&1 </dev/null || die "cannot reach root@$HOST over ssh (is the unit on and is the host right?)"
}

# need_mibpkg: refuse (before any upload) a unit whose mibpkg lacks the sdk verbs.
need_mibpkg() {
  local out rc=0
  out="$(rsh "$MIBPKG sdk status" 2>&1 >/dev/null </dev/null)" || rc=$?
  [ "$rc" = 0 ] || status_failed "$rc" "$out"
}

# status_failed <rc> <stderr>: die on a failed `mibpkg sdk status`. Only a missing binary (126/127, "not found") or a
# mibpkg that does not know the verb ("unknown", "usage") is called missing or old; anything else is shown as is.
status_failed() {
  local rc="$1" out="$2"
  [ "$rc" != 255 ] || die "ssh to root@$HOST failed while checking mibpkg${out:+: $out}"
  if [ "$rc" = 126 ] || [ "$rc" = 127 ] || printf '%s' "$out" | grep -qiE 'not found|no such file|cannot execute|unknown|usage'; then
    die "mibpkg on $HOST is missing or older than 0.9.1; update it (see the mibpkg README)"
  fi
  die "mibpkg sdk status failed on $HOST (exit $rc)${out:+: $out}"
}

check_id() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage_err "invalid plugin id '$1'"; }

# run_mibpkg <arg>...: run the unit's mibpkg and exit with its status (its stdout and stderr pass through). Every
# argument was validated by the caller to the characters [A-Za-z0-9._,=-], so single quotes are enough.
run_mibpkg() {
  local cmd="$MIBPKG" a rc=0
  for a in "$@"; do cmd="$cmd '$a'"; done
  rsh "$cmd" </dev/null || rc=$?
  exit "$rc"
}

# upload <local> <name>: write /tmp/<name> on the unit and compare it byte for byte with the local file; on a
# mismatch remove it (and $UPLOADED_ALSO, an earlier upload of the same set) and die. mibpkg deletes its uploads once it has read them, so every run uploads afresh.
upload() {
  local src="$1" dst="/tmp/$2"
  make_tmp
  if rsh "cat > '$dst'" <"$src" && rsh "cat '$dst'" >"$TMP/verify" 2>/dev/null </dev/null && cmp -s "$src" "$TMP/verify"; then
    return 0
  fi
  rsh "rm -f '$dst'${UPLOADED_ALSO:+ '$UPLOADED_ALSO'}" </dev/null >/dev/null 2>&1 || true
  die "upload of ${src##*/} to $dst failed or did not verify; nothing was installed"
}

# snapshot <file>: copy it to $SNAP; what is uploaded is this copy, not the file on disk (a build may rewrite it
# meanwhile).
snapshot() {
  make_tmp
  SNAP="$TMP/snap.${1##*/}"
  cp "$1" "$SNAP" || die "cannot read $1"
}

# upload_id: 16 random bytes in lowercase hex (mibpkg's upload id rule).
upload_id() { od -An -tx1 -N16 /dev/urandom | tr -d ' \n'; }

# install_mpk <name> <file.mpk> [--probed] [--approve=...]: upload a snapshot of the package and install it as
# <name>. --probed skips the mibpkg probe when the caller already made it.
install_mpk() {
  local name="$1" uid probed=0
  snapshot "$2"
  shift 2
  if [ "${1:-}" = --probed ]; then probed=1; shift; fi
  # Connect only after the snapshot: what is uploaded is the file as it was when the install started, even if the
  # build rewrites it meanwhile.
  connect
  [ "$probed" = 1 ] || need_mibpkg
  uid="$(upload_id)"
  upload "$SNAP" "mibpkg.upload.$uid.mpk"
  run_mibpkg install-file "$name" "$uid" - "$@"
}

cmd_install() {
  local mpk found=() f
  # The host's mibpkg must be new enough before anything is uploaded: refuse an old or missing mibpkg first.
  # No connect here: install_mpk snapshots the package before its own connect.
  need_mibpkg
  if [ -n "${MIBSDK_MPK:-}" ]; then
    mpk="$MIBSDK_MPK"
    [ -f "$mpk" ] || die "MIBSDK_MPK=$mpk is not a file"
  else
    for f in "$DIST"/mibsdk-*.mpk; do [ -f "$f" ] && found+=("$f"); done
    [ "${#found[@]}" = 1 ] \
      || die "found ${#found[@]} mibsdk-*.mpk in $DIST; build with ./gradlew :dist:mibpkgPackage or set MIBSDK_MPK"
    mpk="${found[0]}"
  fi
  install_mpk mibsdk "$mpk" --probed
}

cmd_install_plugin() {
  local mpk="$1" name
  shift
  [ -n "$mpk" ] || usage_err "usage: mibsdk-dev install-plugin <file.mpk> [--approve=<perm,...>] [host]"
  [ -f "$mpk" ] || die "$mpk is not a file"
  name="$( (tar -xzOf "$mpk" manifest.toml 2>/dev/null || true) \
    | awk '/^\[/ { sec = $0; next } sec == "[package]" && /^name[ \t]*=/ { sub(/^[^=]*=[ \t]*"/, ""); sub(/".*$/, ""); print; exit }')"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{1,39}$ ]] || die "cannot read the package name from $mpk (manifest.toml [package] name)"
  install_mpk "$name" "$mpk" "$@"
}

cmd_push() {
  local jar="$1" id
  [ -n "$jar" ] || usage_err "usage: mibsdk-dev push <plugin.jar> [host]"
  [ -f "$jar" ] || die "$jar is not a file"
  [ -f "$jar.stamp" ] \
    || die "$jar.stamp is missing; only jars built by the mibsdk.plugin convention can be pushed: ./gradlew :<project>:mibPluginJar"
  command -v python3 >/dev/null || die "python3 is required on this machine"
  snapshot "$jar"
  cp "$jar.stamp" "$SNAP.stamp" || die "cannot read $jar.stamp"
  id="$(python3 -I - "$SNAP" <<'PY'
import json, sys, zipfile
try:
    with zipfile.ZipFile(sys.argv[1]) as z:
        print(json.loads(z.read("plugin.json").decode("utf-8"))["id"])
except Exception as e:
    sys.exit("mibsdk-dev: cannot read the plugin id from plugin.json: %s" % e)
PY
)" || exit 1
  check_id "$id"
  connect
  need_mibpkg
  upload "$SNAP" "mibpkg.push.$id.jar"
  # A failed stamp upload must not leave the jar behind for a later `sdk push` to pick up.
  UPLOADED_ALSO="/tmp/mibpkg.push.$id.jar"
  upload "$SNAP.stamp" "mibpkg.push.$id.jar.stamp"
  UPLOADED_ALSO=""
  run_mibpkg sdk push "$id"
}

cmd_log() {
  connect
  make_tmp
  rsh "cat '$LOG'" >"$TMP/log" 2>/dev/null </dev/null || die "$LOG not found on $HOST (is the SDK running?)"
  cat "$TMP/log"
}

cmd_restart() {
  connect
  rsh "sync" </dev/null || info "warning: sync failed"
  rsh "slay -s11 j9" </dev/null || true   # the connection may drop with the HMI; slay's own failures print on stderr
  echo "HMI restart requested (slay -s11 j9)"
}

# cmd_ui_forcefail factory|screen|off: the value was validated by the caller.
cmd_ui_forcefail() {
  connect
  if [ "$1" = off ]; then
    rsh "rm -f $FORCEFAIL" </dev/null || die "cannot remove $FORCEFAIL on $HOST"
    echo "ui.forcefail removed on $HOST; restart the HMI (mibsdk-dev restart) for it to take effect"
  else
    # echo, not printf: the unit's shell has no printf
    rsh "mkdir -p $FORCEFAIL_DIR && echo $1 > $FORCEFAIL" </dev/null || die "cannot write $FORCEFAIL on $HOST"
    echo "ui.forcefail=$1 written on $HOST; restart the HMI (mibsdk-dev restart) for it to take effect"
  fi
}

# sdk_verb <verb> <arg>...: a mibpkg sdk verb, after the probe.
sdk_verb() {
  connect
  need_mibpkg
  run_mibpkg sdk "$@"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    # A bare invocation asks "how do I use this" like --help does: usage on stdout, exit 0. An unknown command is a
    # bad command line and exits 2 (below).
    ""|-h|--help|help) usage; exit 0 ;;
  esac
  shift
  # Flags may stand anywhere; the positional host is the last argument, recognised by the per-command arity.
  local want flags=() args=() a
  case "$cmd" in
    install|restart|log|status|uninstall) want=0 ;;
    install-plugin|push|safe-mode|data-clear|remove|ui-forcefail) want=1 ;;
    boot-state|grant) want=2 ;;
    *) usage >&2; usage_err "unknown command '$cmd'" ;;
  esac
  for a in "$@"; do
    case "$cmd:$a" in
      uninstall:--purge|uninstall:--force|remove:--purge) flags+=("$a") ;;
      remove:--purge-data) flags+=(--purge) ;;
      install-plugin:--approve=*)
        [[ "${a#--approve=}" =~ ^[A-Za-z0-9._,-]*$ ]] || usage_err "invalid --approve list '${a#--approve=}'"
        flags+=("$a") ;;
      *:-*) [ "${#args[@]}" -ge "$want" ] || usage_err "unexpected argument '$a'"; args+=("$a") ;;   # a host: set_host refuses it
      *) args+=("$a") ;;
    esac
  done
  local n=${#args[@]}
  if [ "$n" -gt "$want" ]; then
    [ "$n" -eq $((want + 1)) ] || usage_err "too many arguments for '$cmd'"
    set_host "${args[$want]}"
    unset 'args[$want]'
  fi
  set -- "${args[@]+"${args[@]}"}"
  [ -n "$HOST" ] || die "no host: pass it last or set MIBSDK_HOST"
  local f=("${flags[@]+"${flags[@]}"}")
  case "$cmd" in
    install) cmd_install ;;
    uninstall) connect; need_mibpkg; run_mibpkg remove mibsdk "${f[@]+"${f[@]}"}" ;;
    install-plugin) cmd_install_plugin "${1:-}" "${f[@]+"${f[@]}"}" ;;
    push) cmd_push "${1:-}" ;;
    remove)
      [ -n "${1:-}" ] || usage_err "usage: mibsdk-dev remove <id> [--purge|--purge-data] [host]"
      check_id "$1"
      sdk_verb remove "$1" "${f[@]+"${f[@]}"}" ;;
    grant)
      [ $# -eq 2 ] || usage_err "usage: mibsdk-dev grant <id> <perm,...> [host]"
      check_id "$1"
      [[ "$2" =~ ^[A-Za-z0-9._,-]*$ ]] || usage_err "invalid permission list '$2'"
      sdk_verb grant "$1" "$2" ;;
    safe-mode)
      case "${1:-}" in on|off) ;; *) usage_err "usage: mibsdk-dev safe-mode on|off [host]" ;; esac
      sdk_verb safe-mode "$1" ;;
    boot-state)
      [ "${1:-}" = set-wrap ] && [[ "${2:-}" =~ ^[0-9]+$ ]] || usage_err "usage: mibsdk-dev boot-state set-wrap <n> [host]"
      sdk_verb boot-state set-wrap "$2" ;;
    data-clear)
      [ -n "${1:-}" ] || usage_err "usage: mibsdk-dev data-clear <plugin-id> [host]"
      check_id "$1"
      sdk_verb data-clear "$1" ;;
    status)
      # sdk status is the probe itself: it exits 0 whatever it finds, so a failure means no (new enough) mibpkg.
      connect
      make_tmp
      local rc=0
      rsh "$MIBPKG sdk status" 2>"$TMP/status.err" </dev/null || rc=$?
      [ "$rc" = 0 ] || status_failed "$rc" "$(cat "$TMP/status.err")"
      cat "$TMP/status.err" >&2 ;;
    log) cmd_log ;;
    restart) cmd_restart ;;
    ui-forcefail)
      case "${1:-}" in factory|screen|off) ;; *) usage_err "usage: mibsdk-dev ui-forcefail factory|screen|off [host]" ;; esac
      cmd_ui_forcefail "$1" ;;
  esac
}

main "$@"
